{
  "name": "teamgym-team-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run verify:sources && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:local": "npm run build -- --outDir dist-local && vite preview --host 127.0.0.1 --port 5173 --strictPort --outDir dist-local",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm run verify:merge-policy",
    "verify:merge-policy": "vitest run tests/domain/workspace-merge.test.ts -t politikdækning",
    "verify:sources": "node scripts/verify-sources.mjs",
    "test:domain": "vitest run tests/domain",
    "test:drive": "vitest run tests/drive",
    "test:e2e": "playwright test",
    "test:mutations": "node scripts/check-rule-mutations.mjs",
    "test": "npm run test:domain && npm run test:drive"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/gapi": "0.0.47",
    "@types/google.accounts": "0.0.18",
    "@types/google.picker": "0.0.52",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
